# Relay project ignores

# build artifacts
dist/
build/
target/
*.exe~

# Go binaries (compiled outputs)
relayd/relayd
relayd/relayd.exe
station/station
station/station.exe
station/station-linux
station/nativec_linux

# Next.js / Node.js
.next/
node_modules/
# Separate cloud application
cloud-site/


relay-client/node_modules/
relayd/ui-src/node_modules

# Internal tooling
.superpowers/
__pycache__/
*/__pycache__/
**/__pycache__/
*.tsbuildinfo
/smoke-apps/**/obj/
/smoke-apps/**/bin/

# Root-level duplicate Go files (real code lives in relayd/ and station/)
/*.go
/*.test
relay.sln
relay_demo.py
docs/idea.md



# Runtime data (created by relayd at startup)
data/
*.db
*.log

# Local project config (written by relay init)
.relay.json

# Go workspace
go.work
go.work.sum

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
*.swp

# Environment / secrets — never commit these
.env
.env.local
.env.*.local
cloud-site/.env
cloud-site/.env.local
cloud-site/.env.production.local
relayd/.env

